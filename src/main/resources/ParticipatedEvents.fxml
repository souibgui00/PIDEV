<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.ParticipatedEventsController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <HBox layoutY="23.0" prefHeight="46.0" prefWidth="1363.0" style="-fx-background-color: #34459e;">
            <children>
                <Pane prefHeight="46.0" prefWidth="51.0" />
                <Label prefHeight="51.0" prefWidth="240.0" style="-fx-text-fill: #FFFF;" text="Sahtek Event">
                    <font>
                        <Font name="Cambria Bold" size="31.0" />
                    </font>
                </Label>
                <Pane prefHeight="46.0" prefWidth="406.0" />
                <Button mnemonicParsing="false" prefHeight="38.0" onAction="#goToHomePage" prefWidth="78.0" styleClass="Button" stylesheets="@style.css" text="Home" />
                <Pane prefHeight="46.0" prefWidth="37.0" />
                <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="115.0" styleClass="Button" stylesheets="@style.css" text="Evénements" />
                <Pane prefHeight="46.0" prefWidth="37.0" />
                <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="120.0" styleClass="Button" stylesheets="@style.css" text="Contact Us" />
            </children>
        </HBox>

        <Label layoutX="52.0" layoutY="173.0" style="-fx-text-fill: #34459e;" text="Mes Événements Participés" textFill="GOLDENROD">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>

        <!-- Table to display participated events -->
        <TableView fx:id="eventTable" layoutX="50.0" layoutY="250.0" prefWidth="1154.0" prefHeight="500.0">
            <columns>
                <TableColumn fx:id="nameColumn" text="Événement" prefWidth="300.0" />
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="200.0" />
                <TableColumn fx:id="statusColumn" text="Actions" prefWidth="150.0">
                    <cellValueFactory>
                        <!-- Your logic for action buttons (Support, Feedback) goes here -->
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Back Button -->
        <Button layoutX="1060.0" layoutY="190.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="150.0" styleClass="back-button" stylesheets="@style.css" text="Retour" />
    </children>
</AnchorPane>